{
  "name": "tibo-impact",
  "version": "0.1.0",
  "description": "Reversible cross-session model presets for OMP and Pi",
  "type": "module",
  "license": "MIT",
  "author": "happyfeetw",
  "repository": { "type": "git", "url": "https://github.com/happyfeetw/tibo-impact.git" },
  "homepage": "https://github.com/happyfeetw/tibo-impact#readme",
  "bugs": { "url": "https://github.com/happyfeetw/tibo-impact/issues" },
  "keywords": ["pi-package", "omp", "oh-my-pi", "extension", "model-routing"],
  "engines": { "bun": ">=1.3.0" },
  "bin": { "tibo-impact": "bin/tibo-impact.mjs", "omp-impact": "bin/tibo-impact.mjs" },
  "files": ["bin/", "src/", "presets/", "README.md", "LICENSE"],
  "omp": { "extensions": ["./src/hosts/tibo-impact-omp/index.ts"] },
  "pi": { "extensions": ["./src/hosts/tibo-impact-pi/index.ts"] },
  "scripts": {
    "test": "bun test",
    "smoke": "bun scripts/smoke-omp.mjs",
    "smoke:pi": "bun scripts/smoke-pi.mjs",
    "pack:hosts": "bun scripts/package.mjs"
  }
}
